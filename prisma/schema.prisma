generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("support")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  subject    String
  status     String    @default("open")
  priority   String    @default("normal")
  customerId String    @db.ObjectId
  customer   Customer  @relation(fields: [customerId], references: [id])
  mailboxId  String?   @db.ObjectId
  assigneeName  String?
  assigneeEmail String?
  tagIds     String[]  @db.ObjectId
  messages   Message[]
  drafts     Draft[]
  activityLogs ActivityLog[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([updatedAt])
  @@index([assigneeEmail])
}

model Message {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId          String   @db.ObjectId
  ticket            Ticket   @relation(fields: [ticketId], references: [id])
  author            String
  body              String
  externalMessageId String?
  inReplyTo         String?
  createdAt         DateTime @default(now())

  @@index([ticketId])
  @@index([externalMessageId])
}

model WorkflowRule {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  isActive    Boolean  @default(true)
  trigger     String
  actions     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Draft {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String   @db.ObjectId
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String   @db.ObjectId
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
  @@index([type])
}

model AiUsageLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  provider  String
  model     String
  success   Boolean
  error     String?
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String   @db.ObjectId
  messageId String   @db.ObjectId
  mailboxId String?  @db.ObjectId
  to        String
  subject   String
  status    String   @default("sent")
  error     String?
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([mailboxId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String
  title     String
  message   String
  ticketId  String?  @db.ObjectId
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Tag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  color     String   @default("slate")
  createdAt DateTime @default(now())
}

model SavedReply {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  body      String
  shortcut  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlaPolicy {
  id                    String @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  priority              String @unique
  firstResponseMinutes  Int
  resolutionMinutes     Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CsatRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String   @unique @db.ObjectId
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}

model EmailConfig {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  smtpHost      String
  smtpPort      Int      @default(587)
  smtpUser      String
  smtpPass      String
  imapHost      String
  imapPort      Int      @default(993)
  imapUser      String
  imapPass      String
  fromAddress   String   @unique
  fromName      String   @default("Support")
  isActive      Boolean  @default(false)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}