diff --git a/features/organizations/services/tenant-record-scope-service.ts b/features/organizations/services/tenant-record-scope-service.ts
new file mode 100644
index 0000000..9fabf81
--- /dev/null
+++ b/features/organizations/services/tenant-record-scope-service.ts
@@ -0,0 +1,36 @@
+import { prisma } from "@/lib/prisma";
+
+const LEGACY_ORGANIZATION_SLUG = "default-workspace";
+let cachedLegacyOrganizationId: string | undefined;
+
+async function getLegacyOrganizationId() {
+  if (cachedLegacyOrganizationId) return cachedLegacyOrganizationId;
+
+  const organization = await prisma.organization.findUnique({
+    where: { slug: LEGACY_ORGANIZATION_SLUG },
+    select: { id: true },
+  });
+
+  if (organization) cachedLegacyOrganizationId = organization.id;
+  return organization?.id;
+}
+
+/**
+ * Legacy records with no organization are visible only inside the deterministic
+ * default workspace. All other organizations receive a strict tenant filter.
+ */
+export async function getTenantRecordScope(organizationId: string) {
+  const legacyOrganizationId = await getLegacyOrganizationId();
+
+  if (legacyOrganizationId === organizationId) {
+    return {
+      OR: [{ organizationId }, { organizationId: null }],
+    };
+  }
+
+  return { organizationId };
+}
+
+export function getStrictTenantRecordScope(organizationId: string) {
+  return { organizationId };
+}
