 import { prisma } from "@/lib/prisma";
+import { getTenantRecordScope } from "@/features/organizations/services/tenant-record-scope-service";
 
-export async function listEmailTemplates() {
-  return prisma.emailTemplate.findMany({ orderBy: { updatedAt: "desc" } });
+export async function listEmailTemplates(organizationId: string) {
+  const scope = await getTenantRecordScope(organizationId);
+  return prisma.emailTemplate.findMany({
+    where: scope,
+    orderBy: { updatedAt: "desc" },
+  });
 }
 
-export async function createEmailTemplate(data: {
-  name: string;
-  subject: string;
-  body: string;
-}) {
-  return prisma.emailTemplate.create({ data });
+export async function createEmailTemplate(
+  organizationId: string,
+  data: { name: string; subject: string; body: string },
+) {
+  const name = data.name.trim();
+  const existing = await prisma.emailTemplate.findFirst({
+    where: { organizationId, name },
+    select: { id: true },
+  });
+  if (existing) throw new Error("Template name already exists");
+
+  return prisma.emailTemplate.create({
+    data: { organizationId, name, subject: data.subject, body: data.body },
+  });
 }
 
 export async function updateEmailTemplate(
+  organizationId: string,
   id: string,
   data: { name?: string; subject?: string; body?: string },
 ) {
-  return prisma.emailTemplate.update({ where: { id }, data });
+  const scope = await getTenantRecordScope(organizationId);
+  const existing = await prisma.emailTemplate.findFirst({
+    where: { id, ...scope },
+    select: { id: true },
+  });
+  if (!existing) throw new Error("Template not found");
+
+  if (data.name) {
+    const duplicate = await prisma.emailTemplate.findFirst({
+      where: {
+        organizationId,
+        name: data.name.trim(),
+        id: { not: existing.id },
+      },
+      select: { id: true },
+    });
+    if (duplicate) throw new Error("Template name already exists");
+  }
+
+  return prisma.emailTemplate.update({
+    where: { id: existing.id },
+    data: {
+      organizationId,
+      ...(data.name ? { name: data.name.trim() } : {}),
+      ...(data.subject ? { subject: data.subject } : {}),
+      ...(data.body ? { body: data.body } : {}),
+    },
+  });
 }
 
-export async function deleteEmailTemplate(id: string) {
-  return prisma.emailTemplate.delete({ where: { id } });
+export async function deleteEmailTemplate(
+  organizationId: string,
+  id: string,
+) {
+  const scope = await getTenantRecordScope(organizationId);
+  const existing = await prisma.emailTemplate.findFirst({
+    where: { id, ...scope },
+    select: { id: true },
+  });
+  if (!existing) throw new Error("Template not found");
+
+  return prisma.emailTemplate.delete({ where: { id: existing.id } });
 }
