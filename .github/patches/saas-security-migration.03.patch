+  requireOrganizationMembership,
+} from "@/features/organizations/services/organization-service";
 import type { SessionUser } from "@/features/auth/services/session-service";
 
+export type ClerkInvitationMetadata = {
+  organizationId?: string;
+  organizationRole?: string;
+  invitedName?: string;
+};
+
 type ClerkIdentityInput = {
   clerkUserId: string;
   email: string;
   name: string;
+  metadata?: ClerkInvitationMetadata;
 };
 
+const allowedRoles = new Set(["admin", "supervisor", "agent"]);
+
 function normalizeEmail(email: string) {
   return email.trim().toLowerCase();
 }
 
+function normalizeMetadata(
+  metadata?: Record<string, unknown> | ClerkInvitationMetadata | null,
+): ClerkInvitationMetadata {
+  return {
+    organizationId:
+      typeof metadata?.organizationId === "string"
+        ? metadata.organizationId
+        : undefined,
+    organizationRole:
+      typeof metadata?.organizationRole === "string" &&
+      allowedRoles.has(metadata.organizationRole)
+        ? metadata.organizationRole
+        : undefined,
+    invitedName:
+      typeof metadata?.invitedName === "string"
+        ? metadata.invitedName
+        : undefined,
+  };
+}
+
+async function activateInvitedOrganization(
+  userId: string,
+  metadata?: ClerkInvitationMetadata,
+) {
+  const normalized = normalizeMetadata(metadata);
+  if (!normalized.organizationId) return null;
+
+  const organization = await prisma.organization.findUnique({
+    where: { id: normalized.organizationId },
+    select: { id: true, status: true },
+  });
+  if (!organization || organization.status !== "active") return null;
+
+  const membership = await prisma.organizationMember.findUnique({
+    where: {
+      organizationId_userId: {
+        organizationId: organization.id,
+        userId,
+      },
+    },
+  });
+  if (!membership || membership.status === "inactive") return null;
+
+  const role = normalized.organizationRole ?? membership.role;
+  const activatedMembership = await prisma.organizationMember.update({
+    where: { id: membership.id },
+    data: { role, status: "active" },
+  });
+
+  await prisma.user.update({
+    where: { id: userId },
+    data: {
+      defaultOrganizationId: organization.id,
+      role,
+      status: "active",
+    },
+  });
+
+  return {
+    organizationId: organization.id,
+    role: activatedMembership.role,
+  };
+}
+
+async function resolveActiveOrganization(user: {
+  id: string;
+  role: string;
+  defaultOrganizationId?: string | null;
+}) {
+  if (user.defaultOrganizationId) {
+    const current = await requireOrganizationMembership(
+      user.id,
+      user.defaultOrganizationId,
+    );
+    if (current) return current;
+  }
+
+  const membership = await prisma.organizationMember.findFirst({
+    where: { userId: user.id, status: "active" },
+    orderBy: { createdAt: "asc" },
+  });
+  if (membership) {
+    const organization = await prisma.organization.findUnique({
+      where: { id: membership.organizationId },
+      select: { status: true },
+    });
+    if (organization?.status === "active") {
+      await prisma.user.update({
+        where: { id: user.id },
+        data: {
+          defaultOrganizationId: membership.organizationId,
+          role: membership.role,
+          status: "active",
+        },
+      });
+      return {
+        organizationId: membership.organizationId,
+        role: membership.role,
+      };
+    }
+  }
+
+  return ensureLegacyOrganizationForUser(user);
+}
