+async function requireTenantTicket(organizationId: string, ticketId: string) {
+  const scope = await getTenantRecordScope(organizationId);
+  const ticket = await prisma.ticket.findFirst({
+    where: { id: ticketId, ...scope },
+    select: { id: true },
+  });
+  if (!ticket) throw new Error("Ticket not found");
+  return ticket;
+}
 
