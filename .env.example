# Database — MongoDB connection string (local or Atlas)
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/support-platform"

# Session — secret for signing JWT tokens (min 32 characters)
SESSION_SECRET="generate-a-random-string-at-least-32-chars"

# Webhook — shared secret for inbound email HMAC verification
WEBHOOK_SECRET="shared-secret-for-inbound-email-webhook"

# AI Providers — configure one or both; the system tries OpenAI → Anthropic → mock fallback
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"