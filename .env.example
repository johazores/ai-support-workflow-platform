# Bootstrap infrastructure
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/support-platform"

# Product user sessions (legacy auth until Clerk migration is enabled)
SESSION_SECRET="generate-a-random-string-at-least-32-chars"

# Independent Root Admin sessions. Do not reuse SESSION_SECRET.
ROOT_SESSION_SECRET="generate-a-different-random-string-at-least-32-chars"
ROOT_ADMIN_USERNAME="root"
ROOT_ADMIN_PASSWORD="replace-with-a-strong-password"
ROOT_ADMIN_DISPLAY_NAME="Platform Owner"

# 32 random bytes encoded as base64. Used for AES-256-GCM secret encryption.
CONFIG_ENCRYPTION_KEY=""

# Webhook signing
WEBHOOK_SECRET="shared-secret-for-inbound-email-webhook"

# Legacy AI provider variables. Database-managed provider credentials take priority.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Mock AI must never be enabled in production.
ALLOW_MOCK_AI="false"
