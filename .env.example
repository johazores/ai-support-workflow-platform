# Minimal bootstrap infrastructure
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/support-platform"

# Product authentication with Clerk.
# These remain environment variables because Clerk initializes before database runtime settings are available.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/inbox"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/inbox"

# Legacy product session signing secret used only during a controlled migration.
# Enable the migration flow through auth.allow_legacy_product_auth in Root Admin.
SESSION_SECRET="generate-a-random-string-at-least-32-chars"

# Independent Root Admin sessions. Do not reuse SESSION_SECRET.
ROOT_SESSION_SECRET="generate-a-different-random-string-at-least-32-chars"

# One-time Root Admin bootstrap values used by npm run root:bootstrap.
# Remove the password from the runtime environment after provisioning when operationally possible.
ROOT_ADMIN_USERNAME="root"
ROOT_ADMIN_PASSWORD="replace-with-a-strong-password"
ROOT_ADMIN_DISPLAY_NAME="Platform Owner"

# 32 random bytes encoded as base64. Used for AES-256-GCM database secret encryption.
CONFIG_ENCRYPTION_KEY=""

# Runtime configuration is managed in Root Admin and stored in the database.
# Do not add AI keys/models, webhook signing secrets, feature toggles, URLs, or other administrator-managed values here.
